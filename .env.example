# Server environment (see docs/deploy.md). The server (apps/server) owns the
# data and the Google connection; the TUI/CLI (apps/tui) are remote-only clients
# and need just the client-side vars at the bottom. Copy to .env to run the
# server locally.

# Bearer token required on every request (fail-closed: unset = 503, wrong = 401).
# Generate a strong value: openssl rand -hex 32
RP_TOKEN=

# Desktop OAuth client credentials. Override config.json when set.
GOOGLE_CLIENT_ID=YOUR_DESKTOP_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_DESKTOP_OAUTH_CLIENT_SECRET

# App home for all state (OAuth token, per-site SQLite/CSV, config.json).
# On Coolify this points at the mounted volume.
XDG_CONFIG_HOME=/data

# HTTP port the server binds on 0.0.0.0 (default 8790).
SEO_PORT=8790

# Serve the isolated fake fixture instead of live Google data (never calls
# Google; writes only to .debug.sqlite). Equivalent to the `--debug` flag.
# DEBUG=true

# --- Client-side (TUI/CLI talking to a remote server) -----------------------
# Set these instead on a machine that connects to a deployment. Env wins over
# ~/.config/rankstas-paradise/client.json.
# RP_API_URL=https://rp.example.com
# RP_TOKEN=
